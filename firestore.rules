rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the document or if it is a legacy item without a userId field
    function isDocOwner() {
      return isSignedIn() && (
        !('userId' in resource.data) ||
        resource.data.userId == null ||
        resource.data.userId == "" ||
        resource.data.userId == request.auth.uid
      );
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Masters collection
    match /masters/{masterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Erasmus collection
    match /erasmus/{erasmusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Links collection
    match /links/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Scholarship programs collection
    match /scholarship_programs/{programId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Notes collection
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Full Tasks collection
    match /full_tasks/{pageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDocOwner();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
